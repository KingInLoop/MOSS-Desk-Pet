{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MOSS Desk Pet Tauri",
  "version": "1.3.3",
  "identifier": "com.moss.deskpet.tauri",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MOSS Desk Pet",
        "url": "src/index.html",
        "width": 144,
        "height": 156,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../assets/icons/app.ico", "../../assets/icons/app.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "../../assets/icons/app.ico",
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
